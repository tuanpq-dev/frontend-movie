# Backend riêng (chỉ admin dùng)
VITE_API_URL=http://localhost:8080

# Xem chung (Watch Party) — TÙY CHỌN.
# Để trống: dùng P2P (WebRTC qua Trystero), không cần đăng ký gì.
# Điền vào: dùng Supabase Realtime, ổn định hơn ở mạng chặn P2P (4G, wifi công ty).
# Lấy ở Supabase Dashboard > Project Settings > API Keys.
# CHỈ dùng anon/publishable key (công khai). Tuyệt đối không đặt service_role key ở frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
